# ToF test overlay: installs the forked pollen-vision + gstreamer_webrtc on top of
# the production webrtc image already running on the robot.
#
# Find the base image on the robot with `docker ps --format '{{.Image}}'`, then:
#   docker build -f docker/Dockerfile.tof-test --build-arg BASE_IMAGE=<image> -t webrtc:tof-test .
ARG BASE_IMAGE=pollen-robotics/webrtc:latest
FROM ${BASE_IMAGE}

# Both forks installed explicitly. The base image already ships pollen-vision 2.0.1 and its
# package metadata carries the same version number as the fork tag, so relying on the
# transitive pin in gstreamer_webrtc's setup.cfg could silently keep the old copy:
# --force-reinstall guarantees the forks land, --no-deps keeps pip from churning the
# production environment (all runtime deps are already in the base image).
# depthai is pinned explicitly: --no-deps skips pip's resolver, and the fork now targets the
# depthai v3 API (Camera.build/requestOutput, Warp, ToFDepthConfidenceFilter/ImageFilters nodes),
# which does not exist before 3.x. depthai 3.x requires the ToF+IMX296 CCM-EEPROM fix (>=2.28) too.
RUN pip install --no-cache-dir --force-reinstall --no-deps \
    "depthai>=3.8.0,<4.0.0" \
    "git+https://github.com/lkm1321/pollen-vision.git@2.0.1-tof.3" \
    "git+https://github.com/lkm1321/gstreamer_webrtc.git@v1.4.0-tof.3"
